HIKVISION_HOST=192.168.1.40
HIKVISION_USER=admin
HIKVISION_PASSWORD=A112233a
# Postman dagi timezone (AcsEvent startTime/endTime uchun)
HIKVISION_TIMEZONE=+05:00
# Express backend porti (npm run server) — FAQAT kameraga yetadigan kompyuterda!
HIKVISION_SERVER_PORT=3001
# Mac/UI boshqa kompyuterda bo'lsa — backend manzili (server.js ishlaydigan PC IP):
# VITE_HIKVISION_API_URL=http://192.168.1.31:3001
# off = faqat haqiqiy kamera | force = demo | fallback = kamera yo'q bo'lsa demo
HIKVISION_MOCK=off
# Mac bir nechta tarmoqda bo'lsa, LAN IP (ixtiyoriy)
# HIKVISION_LOCAL_ADDRESS=192.168.1.32
# Mac Wi-Fi dan kameraga ulanmasa, Postman ishlaydigan kompyuterda:
#   cd device && npm run relay   (yoki scripts\relay.bat Windows da)
# Faqat shu kompyuterga ping ishlasa gateway ishlaydi:
# HIKVISION_GATEWAY=http://192.168.1.31:5199
VITE_HIKVISION_HOST=192.168.1.40
VITE_HIKVISION_USER=admin
VITE_HIKVISION_PASSWORD=A112233a
VITE_HIKVISION_TIMEZONE=+05:00
DEVICE_PORT=5180
# Ish boshlanish vaqti (kech kelganlarni hisoblash uchun)
VITE_WORK_START_HOUR=9
VITE_WORK_START_MINUTE=0
# Kutilayotgan xodimlar soni (kelmaganlarni hisoblash uchun, ixtiyoriy)
VITE_EXPECTED_EMPLOYEES=0
