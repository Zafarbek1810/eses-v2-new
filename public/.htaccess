# /showresult/213/45/44 → index.html (SPA)
# Vite build: public/.htaccess → dist/.htaccess (yashirin fayl — FTP da ko'rsatishni yoqing)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Mavjud fayl/papka — o'zini ber
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Qolgan barcha route lar (showresult va boshqalar)
  RewriteRule . /index.html [L]
</IfModule>

# Rewrite o'chiq bo'lsa ham 404 → SPA
ErrorDocument 404 /index.html
