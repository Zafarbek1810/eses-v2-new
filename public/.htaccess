# SPA fallback — Apache AllowOverride All + mod_rewrite kerak.
# Agar rewrite o'chiq bo'lsa, showresult havolalari query formatda:
#   https://eses.uz/?orderId=213&analysisId=45&storageId=44

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Rewrite ishlamasa ham deep-link 404 ni SPA ga qaytarish (ba'zi hostlarda)
ErrorDocument 404 /index.html
